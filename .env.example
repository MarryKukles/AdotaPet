# Copie este arquivo para .env e preencha com as credenciais do seu projeto Firebase.
# Se deixar vazio, o AdotaPet funciona em modo demonstração usando localStorage.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
